{
  "enabledMcpjsonServers": ["github"],
  "model": "claude-sonnet-4-6",
  "effortLevel": "medium",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git *)",
      "Bash(python *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Read",
      "Edit(.claude)",
      "Edit(rounds/**)",
      "Edit(strategies/**)",
      "Write(rounds/**)",
      "Write(strategies/**)",
      "Write(trader.py)",
      "NotebookEdit(rounds/**)",
      "Bash(rm -rf *)",
      "Write(data/raw/**)"
    ],
    "deny": [
    ]
  },
  "autoMemoryEnabled": false,
  "spinnerTipsEnabled": false,
  "promptSuggestionEnabled": false,
  "respectGitignore": true,
  "includeGitInstructions": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/Guan/Prosperity4 && git add -A && git diff --cached --quiet || git commit -m \"Auto-save: $(date +%Y-%m-%d_%H:%M:%S)\" && git push origin dev 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
